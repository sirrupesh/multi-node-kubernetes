# Development Cluster
# Multi-node setup with ingress and HA
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
name: sir-multi-node-ingress-cluster

nodes:
# Control plane with ingress
- role: control-plane
  kubeadmConfigPatches:
  - |
    kind: InitConfiguration
    nodeRegistration:
      kubeletExtraArgs:
        node-labels: "ingress-ready=true"
  extraPortMappings:
  - containerPort: 80    # HTTP
    hostPort: 80
    protocol: TCP
  - containerPort: 443   # HTTPS
    hostPort: 443
    protocol: TCP

- role: control-plane  # HA failover

# Application nodes
- role: worker  # Primary
- role: worker  # Scaling
- role: worker  # Redundancy