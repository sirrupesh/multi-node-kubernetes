# Dev Cluster Config
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
name: sir-multi-node-ingress-cluster

nodes:
# Ingress controller
- role: control-plane
  kubeadmConfigPatches:
  - |
    kind: InitConfiguration
    nodeRegistration:
      kubeletExtraArgs:
        node-labels: "ingress-ready=true"
  extraPortMappings:
  - containerPort: 80
    hostPort: 80
    protocol: TCP
  - containerPort: 443
    hostPort: 443
    protocol: TCP

- role: control-plane  # HA pair

# Workload nodes
- role: worker  # Apps
- role: worker  # Scaling
- role: worker  # Backup